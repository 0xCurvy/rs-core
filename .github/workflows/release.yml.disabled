name: Release (disabled)

# Publishes the browser WASM artifacts to npm as @0xcurvy/rs-core-wasm.
#
# crates.io ships Rust source; the JS glue only exists after wasm-bindgen runs,
# and the threaded build needs a pinned nightly with build-std. Reproducing that
# in a TypeScript pipeline is strictly more work than publishing the artifact
# once, from the repo that owns the source. Normal release builds intentionally
# omit the opt-in SPARROW and SAGE features.
on:
  push:
    tags: ["v*"]

permissions:
  contents: read

env:
  CARGO_INCREMENTAL: "0"
  CARGO_TERM_COLOR: always

jobs:
  # Publish only a commit that CI (ci.yml) fully passed on main. CI runs for
  # pushes to main, so the tagged SHA must be the head of such a push. An
  # in-progress run (tag pushed together with main) is waited for.
  ci-passed:
    name: CI passed for the tagged commit
    runs-on: ubuntu-latest
    timeout-minutes: 75
    permissions:
      actions: read
      contents: read
    steps:
      - name: Require a successful ci.yml push run on main for this SHA
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          for attempt in $(seq 1 70); do
            runs="$(gh run list --workflow ci.yml --commit "$GITHUB_SHA" --branch main --event push \
              --limit 20 --json headSha,status,conclusion,url)"
            if jq -e --arg sha "$GITHUB_SHA" \
              'any(.[]; .headSha == $sha and .status == "completed" and .conclusion == "success")' <<<"$runs" >/dev/null; then
              jq -r --arg sha "$GITHUB_SHA" \
                'first(.[] | select(.headSha == $sha and .conclusion == "success")) | "CI passed: \(.url)"' <<<"$runs"
              exit 0
            fi
            if ! jq -e 'any(.[]; .status != "completed")' <<<"$runs" >/dev/null; then
              echo "::error::no successful ci.yml push run on main for $GITHUB_SHA; tag a commit whose main CI run passed"
              exit 1
            fi
            echo "CI for $GITHUB_SHA is still running (check $attempt); waiting"
            sleep 60
          done
          echo "::error::timed out waiting for CI on $GITHUB_SHA"
          exit 1

  # Full differential gate for the generated Poseidon schedule: 10,000
  # deterministic random inputs per arity against the direct reference. It is
  # #[ignore]d in ordinary test runs because of its cost.
  poseidon-gate:
    name: Poseidon 160k release gate
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions-rust-lang/setup-rust-toolchain@166cdcfd11aee3cb47222f9ddb555ce30ddb9659 # v1
        with:
          toolchain: 1.94.0
      - name: Optimized Poseidon matches the reference on 160k cases
        shell: bash
        run: |
          cargo test -p curvy-core --release --locked --lib -- --ignored --exact \
            poseidon::optimized_tests::optimized_schedule_matches_160k_reference_cases | tee poseidon-gate.log
          # A renamed test would otherwise "pass" with zero tests run.
          grep -q '^test result: ok\. 1 passed' poseidon-gate.log

  wasm-portable:
    name: Build portable WASM
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions-rust-lang/setup-rust-toolchain@166cdcfd11aee3cb47222f9ddb555ce30ddb9659 # v1
        with:
          toolchain: 1.94.0
          target: wasm32-unknown-unknown
      - run: cargo install wasm-bindgen-cli --version 0.2.126 --locked
      - run: scripts/build.sh wasm-web
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: wasm-web
          # Both paths live under crates/, so the artifact is rooted there.
          path: |
            crates/wasm/pkg-web
            crates/prover/pkg-web
          if-no-files-found: error
          retention-days: 7

  wasm-threaded:
    name: Build threaded WASM
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions-rust-lang/setup-rust-toolchain@166cdcfd11aee3cb47222f9ddb555ce30ddb9659 # v1
        with:
          toolchain: nightly-2026-07-03
          components: rust-src
          target: wasm32-unknown-unknown
      - run: cargo install wasm-bindgen-cli --version 0.2.126 --locked
      - run: scripts/build.sh wasm-web-threads
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: wasm-web-threads
          path: |
            crates/wasm/pkg-web-threads
            crates/prover/pkg-web-threads
          if-no-files-found: error
          retention-days: 7

  publish:
    name: Publish to npm
    needs: [ci-passed, poseidon-gate, wasm-portable, wasm-threaded]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write # npm provenance attestation
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: 24
          registry-url: https://registry.npmjs.org

      # Releases come off main. CI (ci.yml) only runs on main and pull
      # requests, so a tag anywhere else would publish untested artifacts.
      - name: Tagged commit must be on main
        run: |
          git fetch --no-tags origin main
          if ! git merge-base --is-ancestor "$GITHUB_SHA" origin/main; then
            echo "::error::$GITHUB_SHA is not an ancestor of origin/main" && exit 1
          fi

      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: wasm-web
          path: crates
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4
        with:
          name: wasm-web-threads
          path: crates

      - name: Pack
        id: pack
        run: |
          node scripts/build-npm.mjs --pack
          shopt -s nullglob
          tarballs=(0xcurvy-rs-core-wasm-*.tgz)
          if [ "${#tarballs[@]}" -ne 1 ]; then
            echo "::error::expected exactly one packed tarball, found ${#tarballs[@]}" && exit 1
          fi
          tarball="$GITHUB_WORKSPACE/${tarballs[0]}"
          version="$(tar -xOzf "$tarball" package/package.json | node -p 'JSON.parse(require("fs").readFileSync(0, "utf8")).version')"
          # npm refuses a prerelease without an explicit dist-tag, and a
          # prerelease must never become `latest`. Same `next` tag as
          # scripts/build-node-release.mjs uses for the native packages.
          if [[ "${version%%+*}" == *-* ]]; then dist_tag=next; else dist_tag=latest; fi
          {
            echo "tarball=$tarball"
            echo "sha256=$(sha256sum "$tarball" | cut -d' ' -f1)"
            echo "version=$version"
            echo "dist-tag=$dist_tag"
          } >> "$GITHUB_OUTPUT"
          echo "packed $tarball (version $version, dist-tag $dist_tag)"

      - name: Tag must match the packed version
        env:
          VERSION: ${{ steps.pack.outputs.version }}
        run: |
          if [ "v$VERSION" != "$GITHUB_REF_NAME" ]; then
            echo "::error::tag $GITHUB_REF_NAME does not match package version v$VERSION" && exit 1
          fi

      - name: Smoke-test the packed tarball
        env:
          TARBALL: ${{ steps.pack.outputs.tarball }}
        run: |
          install_dir="$(mktemp -d)"
          cd "$install_dir"
          npm init -y > /dev/null
          npm install --ignore-scripts --no-audit --no-fund "$TARBALL"
          node "$GITHUB_WORKSPACE/scripts/smoke-npm.mjs" "$install_dir"

      # Version immutability is the registry's job: a re-run of the same tag
      # fails here instead of silently replacing a published artifact. The
      # file published is the exact tarball smoke-tested above, not a re-pack.
      - name: Publish
        env:
          TARBALL: ${{ steps.pack.outputs.tarball }}
          TARBALL_SHA256: ${{ steps.pack.outputs.sha256 }}
          DIST_TAG: ${{ steps.pack.outputs.dist-tag }}
        # Configure the package's trusted publisher for this workflow before
        # enabling it. No long-lived publish token is loaded into the runner.
        run: |
          echo "$TARBALL_SHA256  $TARBALL" | sha256sum --check --strict
          npm publish "$TARBALL" --ignore-scripts --provenance --tag "$DIST_TAG"
