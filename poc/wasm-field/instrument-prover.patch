+//! PoC instrumentation (target/claude-scratch copy only, never committed):
+//! accumulate wall time per proof phase so the MSM share of a portable WASM
+//! proof can be measured directly.
+
+use std::cell::RefCell;
+
+pub const WITNESS: usize = 0;
+pub const PROVE: usize = 1;
+pub const WITNESS_MAP: usize = 2;
+pub const MSM_G1: usize = 3;
+pub const MSM_G2: usize = 4;
+pub const VERIFY: usize = 5;
+pub const MSM_G1_POINTS: usize = 6;
+pub const MSM_G2_POINTS: usize = 7;
+pub const MSM_G1_CALLS: usize = 8;
+pub const MSM_G2_CALLS: usize = 9;
+const SLOTS: usize = 10;
+
+thread_local! {
+    static TIMES: RefCell<[f64; SLOTS]> = const { RefCell::new([0.0; SLOTS]) };
+    static CALLS: RefCell<Vec<f64>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Per MSM call: [is_g2, points, ms, zero scalars, one scalars, scalars < 2^64].
+pub fn log_call(is_g2: bool, points: usize, ms: f64, zeros: usize, ones: usize, small: usize) {
+    CALLS.with(|c| {
+        c.borrow_mut().extend([
+            is_g2 as u8 as f64,
+            points as f64,
+            ms,
+            zeros as f64,
+            ones as f64,
+            small as f64,
+        ])
+    });
+}
+
+pub fn take_calls() -> Vec<f64> {
+    CALLS.with(|c| std::mem::take(&mut *c.borrow_mut()))
+}
+
+#[cfg(feature = "wasm")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+extern "C" {
+    #[wasm_bindgen(js_namespace = performance, js_name = now)]
+    fn performance_now() -> f64;
+}
+
+#[cfg(feature = "wasm")]
+pub fn now() -> f64 {
+    performance_now()
+}
+
+#[cfg(not(feature = "wasm"))]
+pub fn now() -> f64 {
+    use std::sync::OnceLock;
+    use std::time::Instant;
+    static START: OnceLock<Instant> = OnceLock::new();
+    START.get_or_init(Instant::now).elapsed().as_secs_f64() * 1e3
+}
+
+pub fn add(slot: usize, started: f64) {
+    let elapsed = now() - started;
+    TIMES.with(|t| t.borrow_mut()[slot] += elapsed);
+}
+
+pub fn add_value(slot: usize, value: f64) {
+    TIMES.with(|t| t.borrow_mut()[slot] += value);
+}
+
+/// Return the accumulated values and reset them.
+pub fn take() -> Vec<f64> {
+    TIMES.with(|t| {
+        let values = t.borrow().to_vec();
+        *t.borrow_mut() = [0.0; SLOTS];
+        values
+    })
+}
