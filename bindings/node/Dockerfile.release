# syntax=docker/dockerfile:1.7

FROM node:22-bookworm@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS node_runtime
FROM rust@sha256:a86cada82e36ebd7a9bffed7548792c55a952fdb20718eea9278a936bcb76e62 AS build
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV CARGO_HOME=/root/.cargo

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
      build-essential \
      ca-certificates \
      clang \
      curl \
      file \
      lld \
      llvm \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN cd bindings/node && npm ci --ignore-scripts

ARG NODE_RELEASE_TARGET
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/src/target \
    set -eux; \
    case "${NODE_RELEASE_TARGET}" in \
      linux-x64) \
        rust_target=x86_64-unknown-linux-gnu; \
        output=curvy_rs_core_node.linux-x64-gnu.node; \
        cross_flag=; \
        ;; \
      linux-arm64) \
        rust_target=aarch64-unknown-linux-gnu; \
        output=curvy_rs_core_node.linux-arm64-gnu.node; \
        cross_flag=; \
        ;; \
      windows-x64) \
        rust_target=x86_64-pc-windows-msvc; \
        output=curvy_rs_core_node.win32-x64-msvc.node; \
        cross_flag=--cross-compile; \
        ;; \
      *) \
        echo "unsupported NODE_RELEASE_TARGET=${NODE_RELEASE_TARGET}" >&2; \
        exit 2; \
        ;; \
    esac; \
    rustup target add "${rust_target}"; \
    cd bindings/node; \
    npm run build -- --target "${rust_target}" ${cross_flag} -- --locked; \
    if [ "${NODE_RELEASE_TARGET}" != windows-x64 ]; then npm test; fi; \
    test -s "${output}"; \
    file "${output}"; \
    mkdir -p /out; \
    cp "${output}" /out/

FROM scratch AS artifact
COPY --from=build /out/ /
